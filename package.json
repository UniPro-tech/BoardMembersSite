{
  "name": "boardmember-system",
  "private": true,
  "scripts": {
    "db:types:generate": "bun run -F @board/db db:types:generate",
    "db:migrate:dev": "bun run -F @board/db db:migrate:dev",
    "db:migrate:deploy": "bun run -F @board/db db:migrate:deploy",
    "db:studio": "bun run -F @board/db db:studio",
    "lint": "bun run --sequential --workspaces lint",
    "lint:fix": "bun run --sequential --workspaces lint:fix",
    "format": "bun run --sequential --workspaces format"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "dotenv": "^17.4.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  }
}
